{
  "manifest_version": 3,
  "name": "ReadFlow",
  "version": "0.4.2",
  "description": "收藏文章与视频到 ReadFlow 资料库，可选飞书链接收录、CSV 导出；分析由已有对话型 agent 承担。",
  "action": {
    "default_title": "ReadFlow",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "alarms"
  ],
  "minimum_chrome_version": "106",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; connect-src https:;"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
