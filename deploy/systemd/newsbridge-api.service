[Unit]
Description=NewsBridge authenticated synchronization API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=newsbridge
Group=newsbridge
WorkingDirectory=/srv/newsbridge/private/cli-state
Environment=HOME=/srv/newsbridge/private
Environment=NEWSBRIDGE_CONFIG=/srv/newsbridge/private/server.config.json
Environment=TZ=Asia/Shanghai
ExecStart=/usr/local/bin/node /srv/newsbridge/app/server/api.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=75
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/newsbridge/private
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
KillMode=control-group

[Install]
WantedBy=multi-user.target
